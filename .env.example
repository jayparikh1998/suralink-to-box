SURALINK_BASE_URL=https://your-suralink-base-url
SURALINK_TOKEN=your-suralink-token

# Choose one selector:
# SURALINK_ENGAGEMENT_ID=12345
# SURALINK_CUSTOMER_NAME=Acme Corp
# SURALINK_CUSTOMER_CUSTOM_ID=acme-001

BOX_AUTH_METHOD=jwt
BOX_JWT_CONFIG_PATH=/Users/shripalparikh/.config/suralink-to-box/box-jwt-config.json
BOX_TARGET_FOLDER_ID=0
# Optional: paste a Box folder shared link in the app instead of browsing from BOX_TARGET_FOLDER_ID
# BOX_TARGET_FOLDER_SHARED_LINK=https://yourcompany.box.com/s/...

# Optional: impersonate a managed Box user instead of using the app service account
# Required if you want JWT root/folder browsing to show that user's existing Box folders.
# BOX_AS_USER_ID=123456789

LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=60
HTTP_MAX_RETRIES=3
